# ==============================================================================
# HireSense AI — Environment Variables Configuration
# Copy this file to .env and adjust variables as required.
# DO NOT commit your actual .env file or production secrets to Git!
# ==============================================================================

# Flask Session Security Secret Key
# Generate a strong key for production (e.g. `python -c "import secrets; print(secrets.token_hex(32))"`)
SECRET_KEY=dev-hiresense-secret-change-in-production-2026

# Environment mode ('development' or 'production')
FLASK_ENV=development
FLASK_DEBUG=1

# SQLite Database File Location (defaults to resume.db in project root)
DATABASE_PATH=resume.db

# Server Port
PORT=5000

# Production Cookie & HTTPS Security Settings (Set to True in production with SSL/TLS)
SESSION_COOKIE_SECURE=False
SESSION_COOKIE_HTTPONLY=True
SESSION_COOKIE_SAMESITE=Lax
